#!/bin/sh
# asus-tso-helper AppImage entry point: the bundled Python runs the bundled app.
HERE="$(dirname "$(readlink -f "$0")")"
export SSL_CERT_FILE="$HERE/opt/_internal/certs.pem"  # HTTPS for update checks
export PYTHONNOUSERSITE=1                           # no packages from ~/.local leak in
unset PYTHONHOME PYTHONPATH
exec "$HERE/opt/python3.12/bin/python3.12" -I "$HERE/opt/asus-tso-helper/asus-tso-helper" "$@"
