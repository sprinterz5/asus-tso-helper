# Maintainer: sprinterz5 <63397324+sprinterz5@users.noreply.github.com>
pkgname=shiftray
pkgver=0.13.0
pkgrel=1
pkgdesc="asusctl and Cardwire in one small app: modes, GPU, fans and battery for ASUS laptops"
arch=(any)
url="https://github.com/sprinterz5/shiftray"
license=(GPL-3.0-only ISC)
depends=(python pyside6 python-evdev python-dbus asusctl hicolor-icon-theme)
optdepends=('cardwire: Eco / Standard GPU modes (AUR)'
            'swayidle: keyboard backlight timeout'
            'libkscreen: refresh rate on KDE Plasma')
makedepends=(make)
provides=(asus-tso-helper)
conflicts=(asus-tso-helper)
replaces=(asus-tso-helper)  # the old name, up to 0.6.1
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('6ccbd3ed9ddbfda9d88e959b68703e51edc9243088dc56fc58e55b0f2f7c0501')

package() {
    cd "$pkgname-$pkgver"
    make install DESTDIR="$pkgdir" PREFIX=/usr
    python -m compileall -q -d /usr/share/$pkgname "$pkgdir/usr/share/$pkgname"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 shiftray/assets/icons/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.lucide"
}
