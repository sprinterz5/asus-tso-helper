#!/usr/bin/env python3
"""Launcher: run asus-tso-helper from a source checkout."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
if "--kbd-idle" in sys.argv:  # run by swayidle; must not start the GUI
    from asus_tso_helper.backend import kbd_idle  # noqa: E402
    kbd_idle(sys.argv[sys.argv.index("--kbd-idle") + 1])
    sys.exit(0)

from asus_tso_helper.ui import main  # noqa: E402

main()
